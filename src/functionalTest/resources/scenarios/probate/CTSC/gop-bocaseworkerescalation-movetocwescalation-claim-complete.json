{
  "description": "GOP BOCaseWorkerEscalation moveToCWEscalation CREATE CLAIM COMPLETE",
  "enabled": true,
  "jurisdiction": "PROBATE",
  "caseType": "GrantOfRepresentation",
  "options": {
    "taskRetrievalApi": "task-management-api"
  },
  "required": {
    "credentials": {
      "key": "systemupdate"
    },
    "ccd": [
      {
        "eventId": "applyforGrantPaperApplicationMan",
        "caseData": {
          "template": "minimal-probate.json",
          "replacements": {
          }
        }
      }
    ]
  },
  "before": {
    "request": {
      "credentials": {
        "key": "caseworker"
      },
      "input": {
        "eventMessages": [
          {
            "destination": "RestEndpoint",
            "template": "minimal-ccd-event-message-probate.json",
            "replacements": {
              "EventId": "moveToCWEscalation",
              "NewStateId": "BOCaseWorkerEscalation",
              "AdditionalData": {
                "Data": {
                  "evidenceHandled": true,
                  "caseType": "gop",
                  "boHandoffReasonList": []
                }
              }
            }
          }
        ]
      }
    },
    "expectations": [
      {
        "credentials": {
          "key": "CTSC-Administrator"
        },
        "status": 200,
        "numberOfTasksAvailable": 2,
        "taskData": {
          "template": "minimal-task-response-probate.json",
          "replacements": {
            "tasks": [
              {
                "test_meta_data": [
                  {
                    "key": "role_data_reference",
                    "value": "ExamineDigitalCaseProbate"
                  }
                ],
                "type": "ExamineDigitalCaseProbate",
                "name": "Examine Digital Case - Probate",
                "minor_priority": 500,
                "major_priority": 5000,
                "due_date": "{$VERIFIER-ZONED_DATETIME_TODAY+10_WORKING_DAYS}",
                "description": "[Amend Case Details](/cases/case-details/${[CASE_REFERENCE]}/trigger/boAmendCaseDetails)  [Issue Grant](/cases/case-details/${[CASE_REFERENCE]}/trigger/boIssueGrantForCaseMatching)  [Escalate to Registrar](/cases/case-details/${[CASE_REFERENCE]}/trigger/boEscalateToRegistrar)  [Select For QA](/cases/case-details/${[CASE_REFERENCE]}/trigger/boSelectForQA)  [SME Referral](/cases/case-details/${[CASE_REFERENCE]}/trigger/moveToCWEscalation)  [Stop Case](/cases/case-details/${[CASE_REFERENCE]}/trigger/boStopCaseForCasePrinted)"
              },
              {
                "task_state": "unassigned",
                "task_system": "SELF",
                "test_meta_data": [
                  {
                    "key": "role_data_reference",
                    "value": "ReviewSMEReferral"
                  }
                ],
                "type": "ReviewSMEReferral",
                "name": "Review SME Referral",
                "minor_priority": 500,
                "major_priority": 5000,
                "due_date": "{$VERIFIER-ZONED_DATETIME_TODAY+10_WORKING_DAYS}",
                "description": "[Handle Supplementary Evidence](/cases/case-details/${[CASE_REFERENCE]}/trigger/handleEvidence)"
              }
            ]
          }
        },
        "roleData": [
          {
            "key": "ReviewSMEReferral",
            "numberOfRolesAvailable": 2,
            "roles": [
              {
                "role_category": "CTSC",
                "role_name": "ctsc",
                "permissions": [ "Read", "Own", "Claim", "Unclaim", "Assign", "Unassign" ],
                "authorisations": ["SKILL:ABA6:ProbateSME"]
              },
              {
                "role_category": "CTSC",
                "role_name": "ctsc-team-leader",
                "permissions": [ "Read", "Own", "Claim", "Unclaim", "Manage", "Complete", "Cancel", "Assign", "Unassign" ],
                "authorisations": ["SKILL:ABA6:ProbateSME"]
              }
            ]
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "request": {
        "type": "CLAIM",
        "credentials": {
          "key": "team-leader",
          "granularPermission": true
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "CTSC-Administrator",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 2,
          "taskData": {
            "template": "minimal-task-response-probate.json",
            "replacements": {
              "tasks": [
                {
                  "task_state": "assigned",
                  "task_system": "SELF",
                  "assignee": "{$ASSIGNEE_ID}",
                  "test_meta_data": [
                    {
                      "key": "role_data_reference",
                      "value": "ExamineDigitalCaseProbate"
                    }
                  ],
                  "type": "ExamineDigitalCaseProbate",
                  "name": "Examine Digital Case - Probate",
                  "minor_priority": 500,
                  "major_priority": 5000,
                  "due_date": "{$VERIFIER-ZONED_DATETIME_TODAY+10_WORKING_DAYS}",
                  "description": "[Amend Case Details](/cases/case-details/${[CASE_REFERENCE]}/trigger/boAmendCaseDetails)  [Issue Grant](/cases/case-details/${[CASE_REFERENCE]}/trigger/boIssueGrantForCaseMatching)  [Escalate to Registrar](/cases/case-details/${[CASE_REFERENCE]}/trigger/boEscalateToRegistrar)  [Select For QA](/cases/case-details/${[CASE_REFERENCE]}/trigger/boSelectForQA)  [SME Referral](/cases/case-details/${[CASE_REFERENCE]}/trigger/moveToCWEscalation)  [Stop Case](/cases/case-details/${[CASE_REFERENCE]}/trigger/boStopCaseForCasePrinted)"
                },
                {
                  "task_state": "assigned",
                  "task_system": "SELF",
                  "assignee": "{$ASSIGNEE_ID}",
                  "test_meta_data": [
                    {
                      "key": "role_data_reference",
                      "value": "ReviewSMEReferral"
                    }
                  ],
                  "type": "ReviewSMEReferral",
                  "name": "Review SME Referral",
                  "minor_priority": 500,
                  "major_priority": 5000,
                  "description": "[Handle Supplementary Evidence](/cases/case-details/${[CASE_REFERENCE]}/trigger/handleEvidence)"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "request": {
        "type": "COMPLETE",
        "credentials": {
          "key": "team-leader",
          "granularPermission": true
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "CTSC-Administrator",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 0
        }
      ]
    }
  ]
}
