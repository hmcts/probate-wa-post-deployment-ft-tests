{
  "description": "Create case with adColligendaBona case type in CasePrinted state, complete this task, then verify boResolveStop in BOReadyToIssue state creates task for ExamineDigitalCaseAdColligendaBona then COMPLETE",
  "enabled": false,
  "jurisdiction": "PROBATE",
  "caseType": "GrantOfRepresentation",
  "options": {
    "taskRetrievalApi": "task-management-api"
  },
  "required": {
    "credentials": {
      "key": "systemupdate"
    },
    "ccd": [
      {
        "eventId": "applyforGrantPaperApplicationMan",
        "caseData": {
          "template": "minimal-probate.json",
          "replacements": {
            "caseType": "adColligendaBona"
          }
        }
      }
    ]
  },
  "before": {
    "request": {
      "credentials": {
        "key": "caseworker"
      },
      "input": {
        "eventMessages": [
          {
            "destination": "RestEndpoint",
            "template": "minimal-ccd-event-message-probate.json",
            "replacements": {
            }
          }
        ]
      }
    },
    "expectations": [
      {
        "credentials": {
          "key": "CTSC-Administrator"
        },
        "status": 200,
        "numberOfTasksAvailable": 1,
        "taskData": {
          "template": "minimal-task-response-probate.json",
          "replacements": {
            "tasks": [
              {
                "task_state": "unassigned",
                "type": "ExamineDigitalCaseAdColligendaBona",
                "name": "Examine Digital Case - Ad Colligenda Bona"
              }
            ]
          }
        },
        "roleData": [
          {
            "key": "ExamineDigitalCaseAdColligendaBona",
            "numberOfRolesAvailable": 2,
            "roles": [
              {
                "role_category": "CTSC",
                "role_name": "ctsc",
                "permissions": [ "Read", "Own", "Claim", "Unclaim", "Assign", "Unassign" ],
                "authorisations": ["SKILL:ABA6:AdColligendaBonaExamining"]
              },
              {
                "role_category": "CTSC",
                "role_name": "ctsc-team-leader",
                "permissions": [ "Read", "Own", "Claim", "Unclaim", "Manage", "Complete", "Cancel", "Assign", "Unassign" ],
                "authorisations": ["SKILL:ABA6:AdColligendaBonaExamining"]
              }
            ]
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "request": {
        "type": "COMPLETE",
        "credentials": {
          "key": "team-leader",
          "granularPermission": true
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "CTSC-Administrator",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 0
        }
      ]
    },
    {
      "request": {
        "credentials": {
          "key": "caseworker"
        },
        "input": {
          "eventMessages": [
            {
              "destination": "RestEndpoint",
              "template": "minimal-ccd-event-message-probate.json",
              "replacements": {
                "EventId": "boResolveStop",
                "NewStateId": "BOReadyToIssue",
                "AdditionalData": {
                  "Data": {
                    "evidenceHandled": false,
                    "caseType": "adColligendaBona",
                    "boHandoffReasonList": []
                  }
                }
              }
            }
          ]
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "CTSC-Administrator",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 1,
          "taskData": {
            "template": "minimal-task-response-probate.json",
            "replacements": {
              "tasks": [
                {
                  "task_state": "unassigned",
                  "type": "ExamineDigitalCaseAdColligendaBonaReadyToIssue",
                  "name": "Examine Digital Case - Ad Colligenda Bona"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "request": {
        "type": "COMPLETE",
        "credentials": {
          "key": "team-leader",
          "granularPermission": true
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "CTSC-Administrator",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 0
        }
      ]
    }
  ]
}
